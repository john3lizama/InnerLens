# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/reflectxr

# ── Object Storage (S3-compatible: AWS S3 or Cloudflare R2) ──
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=reflectxr-images
S3_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── AI Services ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
STABILITY_API_KEY=sk-...

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-prod
