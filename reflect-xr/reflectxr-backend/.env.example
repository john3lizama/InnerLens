# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/reflectxr

# ── Object Storage (S3-compatible: AWS S3 or Cloudflare R2) ──
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=reflectxr-images
S3_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── AI Services ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
STABILITY_API_KEY=sk-...
# Gemini API key — used as fallback for image generation when OpenAI is
# down. Get one at https://aistudio.google.com (free tier works for
# gemini-2.5-flash-image). Leave blank to disable the Gemini fallback.
GEMINI_API_KEY=your-gemini-key-here

# ── Image-gen retry tuning ────────────────────────────────
# When both providers fail on the sync path, the request escalates to a
# background retry loop. Cycles = number of [OpenAI → Gemini] passes;
# backoffs = seconds to wait before each pass (index N = gap before
# pass N). Defaults give ≤ ~2 min total retry window.
IMAGE_RETRY_CYCLES=3
IMAGE_RETRY_BACKOFFS=0,30,90

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-prod

# ── Alexa ─────────────────────────────────────────────
AMAZON_SKILL_ID=amzn1.ask.skill.23e5b7eb-57aa-41b0-88d5-0ca5a99dcbe7
ALEXA_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
