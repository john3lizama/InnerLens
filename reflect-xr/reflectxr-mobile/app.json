{
  "expo": {
    "name": "ReflectXR",
    "slug": "reflectxr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FAFAF8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.innerlens.reflectxr",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "alexa"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8"
      },
      "package": "com.innerlens.reflectxr",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ReflectXR to save artwork to your photo library.",
          "savePhotosPermission": "Allow ReflectXR to save artwork to your photo library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C63FF"
        }
      ]
    ]
  }
}
